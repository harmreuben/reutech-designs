# Copy this file to .env.local and fill in real values. Never commit .env.local.
# While RESEND_API_KEY or QUOTE_TO_EMAIL is empty, `npm run dev` prints quote
# requests in the terminal instead of emailing them.
# In production, add the same variables in Vercel: Project → Settings → Environment Variables.

# Resend API key, starts with re_ (https://resend.com → API Keys). Server-side only.
RESEND_API_KEY=

# Inbox that receives quote requests, e.g. yourname@gmail.com. Comma-separate for more than one.
QUOTE_TO_EMAIL=

# Sender. Until reutechdesigns.com is verified in Resend, use the test sender,
# which can only deliver to the email address of your Resend account.
QUOTE_FROM_EMAIL=Reutech Designs Website <onboarding@resend.dev>

# Optional: extra site addresses allowed to submit the form (comma-separated).
QUOTE_ALLOWED_ORIGINS=
